{
  "name": "OPCodeDecompiler",
  "version": "1.1.0",
  "description": "Symbolic EVM opcode decompiler: turns a disassembler opcode listing into readable pseudo-code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opcode-decompiler": "dist/cli.js"
  },
  "files": [
    "dist",
    "opcodes.csv",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "npm run build && npm run start --",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ethereum",
    "evm",
    "bytecode",
    "decompiler",
    "opcodes",
    "solidity"
  ],
  "author": "Ben Timor",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "papaparse": "^5.7.0",
    "viem": "^2.57.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
